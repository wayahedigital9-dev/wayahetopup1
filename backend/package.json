{
  "name": "wayahedigital-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API & Worker service untuk WayaheDigital",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx src/db/seed.ts",
    "tunnel": "tsx -e \"import('./src/services/ngrok.js').then(m => m.ngrokService.start(4000))\""
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@prisma/client": "^5.10.2",
    "@supabase/server": "^1.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^14.4.0",
    "helmet": "^7.1.0",
    "https-proxy-agent": "^9.1.0",
    "midtrans-client": "^1.3.1",
    "mongodb": "^6.14.2",
    "pg": "^8.23.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "prisma": "^5.10.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
