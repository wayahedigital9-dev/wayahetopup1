# ╔══════════════════════════════════════════════════════════════╗
# ║          WAYAHEDIGITAL BACKEND - ENVIRONMENT CONFIG         ║
# ╚══════════════════════════════════════════════════════════════╝
#
# File ini dibagi menjadi 2 BAGIAN UTAMA:
#   BAGIAN 1: TERMINAL / CONSOLE SETTINGS (server, port, database)
#   BAGIAN 2: API KEY SETTINGS (semua API key pihak ketiga)
#
# Cara pakai:
#   1. Copy file ini: cp .env.example .env
#   2. Isi BAGIAN 1 dulu (jarang berubah)
#   3. Isi BAGIAN 2 dengan API key Anda (dari dashboard masing-masing provider)


# ┌──────────────────────────────────────────────────────────────┐
# │  BAGIAN 1: TERMINAL / CONSOLE SETTINGS                      │
# │  (Setting server lokal, port, database, URL)                 │
# │  Biasanya TIDAK perlu diubah untuk development lokal         │
# └──────────────────────────────────────────────────────────────┘

# Port server backend berjalan
PORT=4000

# Mode: "development" atau "production"
NODE_ENV=development

# URL frontend (React/Vite)
FRONTEND_URL=http://localhost:3000

# Koneksi Database PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Untuk Supabase, copy dari: Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL="postgresql://postgres:password123@localhost:5432/wayahedigital_db?schema=public"


# ┌──────────────────────────────────────────────────────────────┐
# │  BAGIAN 2: API KEY SETTINGS                                  │
# │  (Semua API key dari pihak ketiga / provider)                │
# │  ⚠️  WAJIB diisi dengan key asli dari dashboard provider     │
# └──────────────────────────────────────────────────────────────┘

# ── 2a. PAKASIR API v2 (Multi-channel Payment Gateway & QRIS) ─
# Dapatkan dari: Dashboard Pakasir (https://app.pakasir.com) → API Integration
PAKASIR_BASE_URL="https://app.pakasir.com"
PAKASIR_SLUG="depodomain"
PAKASIR_API_KEY="GANTI_DENGAN_API_KEY_BARU"
PAKASIR_WEBHOOK_SECRET="GANTI_DENGAN_WEBHOOK_SECRET_BARU"
PAKASIR_PAYMENT_METHOD="qris"

# ── 2b. QIOSPAY (QRIS Payment Gateway & Callback Webhook) ────
# Dapatkan dari: Dashboard Qiospay → API & Mutasi QRIS
QIOSPAY_MERCHANT_CODE="YOUR_MERCHANT_CODE"
QIOSPAY_API_KEY="YOUR_API_KEY"
QIOSPAY_SECRET_KEY="mysecret"
QIOSPAY_NMID="ID1020021000000"
QIOSPAY_MERCHANT_NAME="WAYAHE DIGITAL"
QIOSPAY_WEBHOOK_URL="https://domain-anda.com/api/callback/accept/{secret_key}"
# Masukkan string QRIS statis asli LENGKAP dari Qiospay (contoh: 00020101021126...6304XXXX):
QIOSPAY_QRIS_STRING="00020101021126590014ID.LINKAJA.WWW..."
QIOSPAY_QR_STRING=""
STATIC_QRIS_STRING=""
# Aktifkan konversi dinamis lokal HANYA setelah metode ini dikonfirmasi/didukung oleh Qiospay (default false):
QIOSPAY_LOCAL_DYNAMIC_CONFIRMED="false"

# ── 2c. DIGIFLAZZ BUYER API (Multi-Webhook H2H Integration) ────
# Dapatkan dari: https://member.digiflazz.com → API → Buyer
# ⚠️ API KEY, USERNAME & SECRET HANYA untuk backend. JANGAN gunakan prefix NEXT_PUBLIC_!
DIGIFLAZZ_USERNAME="YOUR_DIGIFLAZZ_USERNAME"
DIGIFLAZZ_API_KEY="YOUR_DIGIFLAZZ_API_KEY"
DIGIFLAZZ_WEBHOOK_URL="https://domainanda.com/api/webhooks/digiflazz"
DIGIFLAZZ_WEBHOOK_SECRET="YOUR_DIGIFLAZZ_WEBHOOK_SECRET"
DIGIFLAZZ_TESTING="false"
# Daftar whitelist callback URL terpercaya (pisahkan dengan koma untuk multi-website)
DIGIFLAZZ_ALLOWED_CALLBACK_URLS="https://website-a.com/api/webhooks/digiflazz,https://website-b.com/api/webhooks/digiflazz"
DIGIFLAZZ_BASE_URL="https://api.digiflazz.com/v1"
DIGIFLAZZ_ENFORCE_SIGNATURE="false"
DIGIFLAZZ_WHITELIST_IP=""

# ── 2c. NGROK (Webhook Tunnel) ─────────────────────────────────
# Dapatkan dari: https://dashboard.ngrok.com → Your Authtoken
NGROK_AUTHTOKEN=""
NGROK_DOMAIN=""

# ── 2e. NOTIFIKASI BOT (Telegram & WhatsApp) ────────────────────
# Dapatkan dari: @BotFather di Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Dapatkan dari gateway WhatsApp pilihan Anda (misal: Fonnte, Wablas, dll)
WHATSAPP_BOT_API_KEY=""
WHATSAPP_BOT_NUMBER=""

# ── 2f. FIREBASE CLOUD MESSAGING (Web Push Status Bar HP Admin) ─
# Dapatkan dari: Firebase Console (console.firebase.google.com)
# → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID="your_firebase_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----"
# Atau bisa langsung string JSON satu baris dari file serviceAccountKey.json:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── 2g. INTERNAL SECRETS (Keamanan Internal) ───────────────────
# Bisa pakai value random, ini untuk keamanan internal saja
CRON_SECRET="wayahe_internal_secret_key_8899"
ADMIN_API_KEY="wayahe_admin_secret_token_1234"

