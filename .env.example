# ════════════════════════════════════════════════════════════════
# WAYAHEDIGITAL FRONTEND ENVIRONMENT VARIABLES (.env)
# ════════════════════════════════════════════════════════════════

# ── 1. FIREBASE WEB CONFIG (Web Push Client / FCM) ──────────────
# Dapatkan dari: Firebase Console (console.firebase.google.com)
# → Project Settings → General → Your Apps → Web App (</>)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ── 2. FIREBASE WEB PUSH CERTIFICATES (VAPID Key) ───────────────
# Dapatkan dari: Firebase Console → Project Settings → Cloud Messaging
# → Web configuration → Web Push certificates → Generate key pair
VITE_FIREBASE_VAPID_KEY="BNX_YOUR_PUBLIC_VAPID_KEY_HERE_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── 3. OPTIONAL AI STUDIO CONFIG ────────────────────────────────
GEMINI_API_KEY=""
APP_URL="https://wayahedigital.my.id"

# ── 4. BACKEND DIGIFLAZZ CONFIG (Simpan di backend/.env atau Server Hosting) ──
# ⚠️ PENTING: JANGAN gunakan prefix NEXT_PUBLIC_ atau VITE_ untuk API Key & Secret!
# Kredensial di bawah HARUS HANYA dapat diakses oleh server backend.
DIGIFLAZZ_USERNAME="YOUR_DIGIFLAZZ_USERNAME"
DIGIFLAZZ_API_KEY="YOUR_DIGIFLAZZ_API_KEY"
DIGIFLAZZ_WEBHOOK_URL="https://domainanda.com/api/webhooks/digiflazz"
DIGIFLAZZ_WEBHOOK_SECRET="YOUR_DIGIFLAZZ_WEBHOOK_SECRET"
DIGIFLAZZ_TESTING="false"
DIGIFLAZZ_ALLOWED_CALLBACK_URLS="https://website-a.com/api/webhooks/digiflazz,https://website-b.com/api/webhooks/digiflazz"

VITE_ADMIN_TOKEN="isi-dari-backend-ADMIN_TOKEN"
